# Resend: wysyłka zapytań z formularza
RESEND_API_KEY=

# Cloudflare Turnstile: ochrona formularza
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Plausible: adres skryptu przypisanego do lunarisweb.pl (panel Plausible → Site installation),
# np. https://plausible.io/js/pa-XXXXX.js. Pusty = analityka wyłączona.
NEXT_PUBLIC_PLAUSIBLE_SRC=
